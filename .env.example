# Each setting must occupy its own line. Fill these three values before launch.
BOT_TOKEN=
ADMIN_TELEGRAM_IDS=
POSTGRES_PASSWORD=

POSTGRES_DB=hotel_photo_bot
POSTGRES_USER=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DB_CONNECT_ATTEMPTS=30
DB_CONNECT_DELAY=2
PHOTO_PRICE=400
MANAGER_PERCENT=15
PHOTOGRAPHER_PERCENT=10
TRAINING_TIMEZONE=Europe/Moscow
# Optional receipt image extraction (manual owner review works without a key).
# Never put a real key in GitHub. Configure it in Render Environment.
OPENAI_API_KEY=
RECEIPT_ANALYSIS_MODEL=gpt-4.1-mini
# AI assessment of Academy practice. Uses the same OPENAI_API_KEY.
ACADEMY_ANALYSIS_MODEL=gpt-4.1-mini
# Optional persistent FSM and cross-instance locks. Use Render Key Value internal URL.
REDIS_URL=
# Optional outside Docker: DATABASE_URL=postgresql+asyncpg://...
# Optional for a self-hosted Telegram Bot API: TELEGRAM_API_BASE=http://host:8081


# Optional Yandex.Disk app-folder storage. Configure real values only in Render.
# OAuth scope: cloud_api:disk.app_folder. Client secret is not required for token use.
YANDEX_DISK_TOKEN=
YANDEX_DISK_CLIENT_ID=
# WebRTC calls: optional TURN relay for restrictive hotel/mobile networks.
# Supply either a coturn REST secret or a provider username + credential.
# Keep one Render instance / one Python process for the in-memory call service.
CALLS_TURN_URLS=
CALLS_TURN_SECRET=
CALLS_TURN_USERNAME=
CALLS_TURN_CREDENTIAL=
