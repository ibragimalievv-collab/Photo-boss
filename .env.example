# Each setting must occupy its own line. Fill these three values before launch.
BOT_TOKEN=
ADMIN_TELEGRAM_IDS=
POSTGRES_PASSWORD=

POSTGRES_DB=hotel_photo_bot
POSTGRES_USER=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DB_CONNECT_ATTEMPTS=30
DB_CONNECT_DELAY=2
PHOTO_PRICE=400
MANAGER_PERCENT=15
PHOTOGRAPHER_PERCENT=10
TRAINING_TIMEZONE=Europe/Moscow
# Require GPS for attendance by default. Only the owner may temporarily set 0.
# With 0: a readable camera photo is still required; location is not verified.
PHOTO_BOSS_ATTENDANCE_GPS_REQUIRED=1
# Keep GPS required; set this to 0 only to postpone matching hotel reference zones.
PHOTO_BOSS_ATTENDANCE_GEOFENCE_REQUIRED=1
# Optional receipt image extraction (manual owner review works without a key).
# Never put a real key in GitHub. Configure it in Render Environment.
OPENAI_API_KEY=
RECEIPT_ANALYSIS_MODEL=gpt-4.1-mini
# AI assessment of Academy practice. Uses the same OPENAI_API_KEY.
ACADEMY_ANALYSIS_MODEL=gpt-4.1-mini
# Optional persistent FSM and cross-instance locks. Use Render Key Value internal URL.
REDIS_URL=
# Optional outside Docker: DATABASE_URL=postgresql+asyncpg://...
# Optional for a self-hosted Telegram Bot API: TELEGRAM_API_BASE=http://host:8081


# Optional Yandex.Disk app-folder storage. Configure real values only in Render.
# OAuth scope: cloud_api:disk.app_folder. Client secret is not required for token use.
YANDEX_DISK_TOKEN=
YANDEX_DISK_CLIENT_ID=
# WebRTC calls: optional TURN relay for restrictive hotel/mobile networks.
# Supply either a coturn REST secret or a provider username + credential.
# Keep one Render instance / one Python process for the in-memory call service.
CALLS_TURN_URLS=
CALLS_TURN_SECRET=
CALLS_TURN_USERNAME=
CALLS_TURN_CREDENTIAL=

# Separate candidate bot @Really_boss_HR_bot; optional and off by default.
# Store real HR_BOT_TOKEN only in Render Environment, never in Git.
HR_BOT_ENABLED=0
HR_BOT_TOKEN=

# Staged Sber QR.API settings, separate from SBER_MERCHANT_* acquiring credentials.
# Store real values only in Render Environment, never in Git or chat.
# These settings alone do not activate payments or prove bank acceptance.
# See docs/sber-qr-api-setup.md. Keep disabled until bank acceptance is complete.
SBER_QR_ENABLED=0
SBER_QR_ENV=sandbox
SBER_QR_CLIENT_ID=
SBER_QR_CLIENT_SECRET=
# Password chosen for the client certificate, not ClientSecret or SberBusiness login.
SBER_QR_CERT_PASSWORD=
# Render Secret File: base64 of the original encrypted .p12, never decrypted PEM.
SBER_QR_CERT_FILE=/etc/secrets/sber-qr-client.p12.b64
SBER_QR_CERT_FORMAT=p12-base64
# Optional trusted server CA bundle (extends system roots; does not disable TLS).
SBER_QR_CA_FILE=
# Obtain these merchant/QR/terminal identifiers from Sber; never invent values.
SBER_QR_MEMBER_ID=
SBER_QR_ID_QR=
SBER_QR_TID=
# Sandbox endpoints must be explicitly confirmed for this product by the bank.
# No sandbox URL or successful response-code mapping is guessed by the adapter.
SBER_QR_API_BASE_URL=
SBER_QR_TOKEN_URL=
SBER_QR_ENDPOINTS_CONFIRMED=0
SBER_QR_SUCCESS_CODE=
SBER_QR_OPERATION_SUCCESS_CODE=
